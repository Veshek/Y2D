# Copy to .env and fill in. NEVER commit the real .env.

# --- Google OAuth (from Google Cloud console > Credentials > OAuth client, type "Web") ---
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# Must exactly match an authorized redirect URI on that OAuth client.
OAUTH_REDIRECT_URI=http://localhost:8000/auth/callback

# Set in production: the service account Cloud Tasks uses to call the private worker.
# WORKER_INVOKER_SA=clipflow-tasks@your-project.iam.gserviceaccount.com
