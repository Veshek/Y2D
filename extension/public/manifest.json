{
  "manifest_version": 3,
  "name": "Y2D",
  "version": "0.1.0",
  "description": "Bulk-transfer videos from Google Drive to YouTube, server-side — no download required.",
  "key": "",
  "action": {
    "default_popup": "index.html",
    "default_title": "Y2D"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://drive.google.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "permissions": ["identity", "storage"],
  "host_permissions": [
    "http://localhost:8000/*",
    "https://drive.google.com/*"
  ]
}
