{
  "manifest_version": 3,
  "name": "Y2D",
  "version": "0.1.0",
  "description": "Bulk-transfer videos from Google Drive to YouTube, server-side — no download required.",
  "key": "",
  "oauth2": {
    "client_id": "539912545761-dnak4h59obrha2fvh37v750cmjvb99ma.apps.googleusercontent.com",
    "scopes": ["https://www.googleapis.com/auth/youtube.readonly"]
  },
  "action": {
    "default_title": "Y2D"
  },
  "side_panel": {
    "default_path": "index.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://drive.google.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "permissions": ["identity", "storage", "tabs", "activeTab", "sidePanel"],
  "host_permissions": [
    "http://localhost:8000/*",
    "https://drive.google.com/*"
  ]
}
